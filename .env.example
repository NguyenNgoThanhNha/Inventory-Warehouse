# Copy thành .env (KHÔNG commit .env). Dùng cho docker-compose.yml (demo) và docker-compose.prod.yml.
SA_PASSWORD=Change-Me-Strong-Passw0rd
# >= 32 ký tự ngẫu nhiên, vd: openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars
# URL công khai của FE (CORS + link trong email)
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# true = tạo tài khoản + dữ liệu demo (chỉ nên bật cho bản demo)
SEED_DEMO_DATA=true
# Image (docker-compose.prod.yml): ghcr.io/<github-user>/inventory, tag = latest | 1.0.0 | <sha>
IMAGE_PREFIX=ghcr.io/OWNER/inventory
IMAGE_TAG=latest
