{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=InventoryDb;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "inventory-api",
    "Audience": "inventory-web",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false,
    "SeedBulkProducts": 0
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5174"
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "ApiLogging": {
    "Enabled": true,
    "Module": "Inventory",
    "LogGetRequests": false,
    "MaxBodyLength": 32768,
    "RetentionDays": 30,
    "ExcludedPaths": [ "/health", "/swagger", "/api/v1/api-logs", "/api/v1/notifications/unread-count" ],
    "SensitiveFields": [ "password", "newPassword", "currentPassword", "accessToken", "refreshToken", "token" ]
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 20
  },
  "Cors": {
    "Origins": [ "http://localhost:5174" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
